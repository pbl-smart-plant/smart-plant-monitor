/*
 * secrets.h.exemplo - modelo dos segredos do vaso
 *
 * 1. Copia este ficheiro para "secrets.h" (na mesma pasta).
 * 2. Preenche os dois valores. O secrets.h está no .gitignore: NUNCA vai para o GitHub.
 *
 * O Wi-Fi NAO fica aqui: configura-se pelo telemovel (rede "PlantCare-Setup",
 * WiFiManager) e fica guardado no ESP32.
 */
#pragma once

// Endereco do servidor (sem "/" no fim). Na AWS: o Elastic IP da VM.
#define API_URL "http://IP_DA_VM:8000"

// Chave do vaso: o admin gera-a com  python criar_dispositivo.py PC-XXXX
// e envia-a ao dono por mensagem PRIVADA.
#define API_KEY "cola_aqui_a_chave_do_teu_vaso"

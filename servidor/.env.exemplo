# Copiar para .env e trocar os valores. O .env NUNCA vai para o GitHub
#(serve apenas para ficar o passo ficar visivel no git).
# Na AWS: gerar cada password com  openssl rand -base64 24

# dev = o teu computador (permite apagar a BD e carregar dados de teste)
# producao = a VM da AWS
AMBIENTE=dev

MYSQL_ROOT_PASSWORD=root_local
API_DB_PASSWORD=api_local
GRAFANA_DB_PASSWORD=grafana_local
GRAFANA_ADMIN_PASSWORD=admin_local

# --- API
# Onde está o MySQL. No Mac: 127.0.0.1 (a porta aberta pelo docker-compose).
# No Docker (Parte 3) passa a ser "mysql", o nome do serviço.
DB_HOST=127.0.0.1
# Endereço do Grafana, para o CORS dos formulários
GRAFANA_URL=http://localhost:3000

# --- Grafana: email
# false = sem email (registo livre sem confirmação). true = confirmação de conta e
# "esqueci-me da password", através do Gmail do projeto (palavra-passe de app).
GRAFANA_EMAIL_ATIVO=false
SMTP_USER=
SMTP_PASSWORD=
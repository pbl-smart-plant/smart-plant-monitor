# Copiar para .env e trocar os valores. O .env NUNCA vai para o GitHub
#(serve apenas para ficar o passo ficar visivel no git).
# Na AWS: gerar cada password com  openssl rand -base64 24

# dev = o teu computador (permite apagar a BD e carregar dados de teste)
# producao = a VM da AWS
AMBIENTE=dev

MYSQL_ROOT_PASSWORD=root_local
API_DB_PASSWORD=api_local
GRAFANA_DB_PASSWORD=grafana_local
GRAFANA_ADMIN_PASSWORD=admin_local